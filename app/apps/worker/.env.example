NODE_ENV=development
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
WORKER_ID=1
LOG_LEVEL=info

# 布尔 / 枚举键（第 124 批起的唯一入口）：1/true/yes/on = 开，0/false/no/off = 关；不区分大小写、首尾空白忽略。
# 留空 = 未配置 → 取该键默认值。适用：ADAPTER_MODE / ARK_IMAGE_RESPONSE_FORMAT / ARK_IMAGE_WATERMARK /
# AI_LABEL_ENABLED / STORAGE_DRIVER / STORAGE_S3_FORCE_PATH_STYLE
# 适配器：mock（本地/CI，不访问供应商）| real（需真实 Key）；大小写不敏感（Real / REAL 与 real 同义）
ADAPTER_MODE=mock
# 供应商路由：off=只用环境变量 / fallback=有路由走库、无路由回落 / on=只走库
# PROVIDER_DB_RESOLVE=off
# 与 API 共用同一把主密钥；生产启用数据库路由时必填（≥32 字符）
# PROVIDER_ENCRYPTION_KEY=change-me-32chars-minimum
# 非生产未配 PROVIDER_ENCRYPTION_KEY 时，从同一 JWT_SECRET 派生（须与 API 一致）
# JWT_SECRET=change-me-32chars-minimum
# DEEPSEEK_API_KEY= / DEEPSEEK_BASE_URL=https://api.deepseek.com / DEEPSEEK_MODEL=deepseek-chat

# 火山方舟（Ark）专用适配器（volcengine:* 视频任务）
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com
# ARK_MODEL_MAP={"seedance-2.5":"ep-xxxxxxxx"}

# 火山方舟图像生成（Seedream；与视频共用 ARK_API_KEY）
# 真实模式下 volcengine:image / volcengine:seedream 自动指向 Ark 图像；
# 图像模型名映射可独立于视频：{"seedream-3.0":"doubao-seedream-3-0-t2i-250415"} 或接入点 ep-xxxx
# ARK_IMAGE_MODEL_MAP={"seedream-3.0":"doubao-seedream-3-0-t2i-250415"}
# ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com
# 单次请求超时（图片生成较慢，默认 120000ms）
# ARK_IMAGE_TIMEOUT_MS=120000
# url（推荐，结果由 worker 转存自有 OSS）| b64_json（仅调试）；大小写不敏感
# ARK_IMAGE_RESPONSE_FORMAT=url
# 显式水印（AI 标识合规，默认 true；关闭需走合规评审）：写 0/false/no/off 才是关，留空仍是默认 true
# ARK_IMAGE_WATERMARK=true
# 运营显式选择：把既有 adapter_code 路由到 Ark 图像，逗号分隔（未配置则保持原报错，不会静默 mock）
# ARK_IMAGE_REPLACE_CODES=tomoviee:image

# 通用 HTTP 视频供应商（real 模式下配置后所有视频/图像 code 走此网关）
# HTTP_VIDEO_BASE_URL=https://vendor-gateway.example.com
# HTTP_VIDEO_API_KEY=
# HTTP_VIDEO_SUBMIT_PATH=/v1/video/tasks
# HTTP_VIDEO_POLL_PATH=/v1/video/tasks/{id}
# HTTP_VIDEO_CANCEL_PATH=/v1/video/tasks/{id}/cancel
# HTTP_VIDEO_MODEL_MAP={"seedance-2.5":"doubao-seedance-2.5"}

# AI 生成内容双标识（显式水印 + 隐式元数据；上线不可关闭）：=0/false/no/off 才是关
AI_LABEL_ENABLED=true
AI_LABEL_TEXT=AI生成
# AI_LABEL_FONT_PATH=C:/Windows/Fonts/msyh.ttc
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# VOLC_AK= / VOLC_SK= / DASHSCOPE_KEY=

# 结果存储（与 api 共享同一目录/桶；生产替换 OSS/S3）：local | s3，大小写不敏感
# STORAGE_DRIVER=local
# STORAGE_DIR=../../data/storage
# STORAGE_PUBLIC_BASE=http://127.0.0.1:3000/v1
# STORAGE_SIGN_SECRET=change-me
# S3/OSS（STORAGE_DRIVER=s3）
# STORAGE_S3_BUCKET=oneframe-results
# STORAGE_S3_REGION=cn-hangzhou
# STORAGE_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STORAGE_S3_ACCESS_KEY_ID= / STORAGE_S3_SECRET_ACCESS_KEY=
# 路径风格访问（MinIO 等 S3 兼容服务通常 true；布尔写法见文件头）
# STORAGE_S3_FORCE_PATH_STYLE=false
# 签名用的对外 endpoint（浏览器可达的公网域名；与 STORAGE_S3_ENDPOINT 内网地址不同时才填）
# STORAGE_S3_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# ── P10：real 模式下出站素材 URI 的签名有效期（秒），需覆盖供应商最长任务耗时
# 真实适配器要求素材 URI 公网可达：STORAGE_DRIVER=s3（STORAGE_S3_PUBLIC_ENDPOINT 公网域名）
# 或把 STORAGE_PUBLIC_BASE 设为公网反代/隧道地址；loopback 会被 worker 守卫拦截（745900）
ADAPTER_URI_TTL_SECONDS=21600

# ── 队列、看门狗与停机（毫秒；括号内为不配置时的默认值）──
# 单队列并发（默认 5）；调大需同时看 DB 连接池与供应商限流
# WORKER_CONCURRENCY=5
# 供应商任务轮询间隔 / 单任务轮询上限（默认 1000 / 900000=15 分钟）
# POLL_INTERVAL_MS=1000
# POLL_MAX_MS=900000
# 任务看门狗（默认 60000）：卡死任务置失败并解冻预扣积分
# TASKS_WATCHDOG_INTERVAL_MS=60000
# 发布转码看门狗（默认 120000）
# PUBLICATIONS_WATCHDOG_INTERVAL_MS=120000
# 订单对账（默认 300000）
# ORDERS_RECONCILE_INTERVAL_MS=300000
# 分享过期清理（默认 3600000）
# SHARES_EXPIRE_INTERVAL_MS=3600000
# 资金对账（默认 86400000=每日）
# FLOWS_AUDIT_INTERVAL_MS=86400000
# 数据保留清理（默认 21600000=6 小时；结果 90 天 / 回收站 7 天 / 注销 30 天）
# MAINTENANCE_INTERVAL_MS=21600000
# 停机宽限（默认 25000）：超时强制退出，BullMQ 会把未完成 job 重投
# SHUTDOWN_TIMEOUT_MS=25000
