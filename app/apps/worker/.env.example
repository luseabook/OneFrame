NODE_ENV=development
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
WORKER_ID=1
LOG_LEVEL=info

# 适配器：mock（本地/CI，不访问供应商）| real（需真实 Key）
ADAPTER_MODE=mock
