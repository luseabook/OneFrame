# Web 运行时（Nuxt）
# 空 = 同源 /v1（开发期由 NUXT_API_PROXY 代理到本地 API）
NUXT_PUBLIC_API_BASE=
NUXT_API_PROXY=http://127.0.0.1:3000

# === 备案号（生产必填；验收机可临时用逃生舱）===
# 形如 京ICP备2024000000号-1；缺失时生产启动即失败（server/plugins/icp-guard.ts）
NUXT_PUBLIC_ICP_BEIAN=
# 公安联网备案号；形如 京公网安备11010500000000号
NUXT_PUBLIC_ICP_POLICE=
# 仅非对外验收机可设 1：放行「无备案号」启动，但每次启动必打 WARN；对外机器禁止设置
ONEFRAME_ALLOW_MISSING_ICP=
