NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# 鉴权（ADR-006/007/008；生产必须通过服务器 env/CI Secrets 注入）
# JWT_SECRET=change-me-32bytes-min
# ACCESS_TTL_S=7200
# REFRESH_TTL_S=1209600
# PHONE_HMAC_PEPPER=change-me
# PHONE_ENC_KEY=change-me-32bytes
# 运营后台（生产必须显式设置；非生产缺省 admin/admin12345）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong
# ADMIN_JWT_TTL_S=7200

# Alpha 准入与新人礼包
# AUTH_REQUIRE_INVITE=false
# GIFT_CREDITS=80
# QUOTE_TTL_S=300

# 结果存储（本地驱动，生产替换 OSS/S3）
# STORAGE_DRIVER=local
# STORAGE_DIR=../../data/storage
# STORAGE_PUBLIC_BASE=http://127.0.0.1:3000/v1
# STORAGE_SIGN_SECRET=change-me
# S3/OSS（STORAGE_DRIVER=s3）
# STORAGE_S3_BUCKET=oneframe-results
# STORAGE_S3_REGION=cn-hangzhou
# STORAGE_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STORAGE_S3_ACCESS_KEY_ID= / STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=false

# 短信/验证码/支付/供应商 Key 一律走服务器 env 或 CI Secrets，不写入本文件

# ── 支付渠道（api-spec §10）──
# PAYMENT_LIVE=false：仅 mock 渠道可用于联调；=true：只接受真实渠道下单/回调，mock 端点返回 403
# PAYMENT_LIVE=false
# ORDER_TTL_S=900
#
# 微信支付 APIv3（生产值全部由 Secrets 注入；以下仅为占位）
# WECHAT_MCH_ID=1900000000
# WECHAT_APP_ID=wx0000000000000000
# WECHAT_MCH_SERIAL_NO=0000000000000000000000000000000000000000
# 商户 API 私钥：内联 PEM（用 \n 换行）或挂载文件路径（二选一，推荐文件）
# WECHAT_MCH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# WECHAT_MCH_PRIVATE_KEY_PATH=/run/secrets/wechat_mch_private_key.pem
# APIv3 密钥（32 字符，回调解密）
# WECHAT_API_V3_KEY=change-me-32-chars
# 微信支付平台证书公钥（回调验签）：内联或文件路径
# WECHAT_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# WECHAT_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechat_platform_public_key.pem
# 平台证书轮换（推荐）：JSON {"<serial_no>":"<PEM>"}，可同时配置新旧证书；回调按 Wechatpay-Serial 选公钥
# WECHAT_PLATFORM_PUBLIC_KEYS={"5157F09EFDC096DE15EBE81A47057A7232FDB129":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
# WECHAT_PLATFORM_PUBLIC_KEYS_PATH=/run/secrets/wechat_platform_public_keys.json
# WECHAT_API_BASE=https://api.mch.weixin.qq.com
# WECHAT_NOTIFY_URL=https://api.example.com/v1/billing/notify/wechat
#
# 支付宝开放平台（RSA2）
# ALIPAY_APP_ID=2021000000000000
# ALIPAY_APP_PRIVATE_KEY_PATH=/run/secrets/alipay_app_private_key.pem
# ALIPAY_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ALIPAY_PUBLIC_KEY_PATH=/run/secrets/alipay_public_key.pem
# ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# 生产默认网关；沙箱请显式覆盖（沙箱网关不接受生产密钥）
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_NOTIFY_URL=https://api.example.com/v1/billing/notify/alipay
# ALIPAY_SIGN_TYPE=RSA2
#
# ── 生产启动守卫（NODE_ENV=production 时 fail fast；api-spec §10.6）──
# 必须显式提供且不能是仓库默认值：JWT_SECRET / PHONE_HMAC_PEPPER / PHONE_ENC_KEY
# 必须显式提供：ADMIN_USERNAME / ADMIN_PASSWORD；COOKIE_SECURE 必须显式设置（HTTPS 为 true）
# PAYMENT_LIVE=true 时至少一个渠道凭据齐全；已配置但缺项的渠道会列出缺失变量并拒绝启动
