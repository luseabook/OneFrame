NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
# 雪花 ID 的 worker 位（0..1023；留空 = pid % 1024；多实例部署应显式指定避免碰撞）
# WORKER_ID=

# 布尔 / 枚举键（第 124 批起的唯一入口）：1/true/yes/on = 开，0/false/no/off = 关；不区分大小写、首尾空白忽略。
# 留空 = 未配置 → 取该键默认值。适用：STORAGE_DRIVER / STORAGE_S3_FORCE_PATH_STYLE / OAUTH_MOCK /
# CAPTCHA_ENFORCE / MODERATION_ENABLED / CATALOG_SYNC_TOOLS
# （COOKIE_SECURE / AUTH_REQUIRE_INVITE / SEED_SAMPLE_PROJECT / PAYMENT_LIVE 仍只接受小写 true / false）

# 鉴权（ADR-006/007/008；生产必须通过服务器 env/CI Secrets 注入）
# JWT_SECRET=change-me-32bytes-min
# ACCESS_TTL_S=7200
# REFRESH_TTL_S=1209600
# PHONE_HMAC_PEPPER=change-me
# PHONE_ENC_KEY=change-me-32bytes
# 管理端 JWT 独立密钥（生产必填；开发/测试缺省回落 JWT_SECRET，与用户域密钥物理分离）
# ADMIN_JWT_SECRET=change-me-32bytes-min
# 运营后台（生产必须显式设置；非生产缺省 admin/admin12345）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong
# ADMIN_JWT_TTL_S=7200
# 刷新令牌 Cookie 的 Secure 标记（HTTPS 部署必须 true；纯 HTTP 内网须显式 false，否则刷新即掉登录）
# COOKIE_SECURE=true
# /v1/metrics 抓取令牌（≥16 字符；未配置时端点一律 401）
# METRICS_TOKEN=change-me-16chars-min
# master token 有效期（秒，默认 2592000=30 天；仅用于换取 access token）
# MASTER_TTL_S=2592000

# Alpha 准入与新人礼包
# AUTH_REQUIRE_INVITE=false
# GIFT_CREDITS=80
# QUOTE_TTL_S=300
# 新用户自动建示例作品（默认 true；关掉后注册体验是空作品列表）
# SEED_SAMPLE_PROJECT=true
# 短信 IP 频控（条/小时）：默认 20；test 环境默认 100000（多个 spec 共用 127.0.0.1）
# SMS_IP_HOURLY_LIMIT=20

# 结果存储（本地驱动，生产替换 OSS/S3）：local | s3，大小写不敏感
# STORAGE_DRIVER=local
# STORAGE_DIR=../../data/storage
# STORAGE_PUBLIC_BASE=http://127.0.0.1:3000/v1
# STORAGE_SIGN_SECRET=change-me
# S3/OSS（STORAGE_DRIVER=s3）
# STORAGE_S3_BUCKET=oneframe-results
# STORAGE_S3_REGION=cn-hangzhou
# STORAGE_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STORAGE_S3_ACCESS_KEY_ID= / STORAGE_S3_SECRET_ACCESS_KEY=
# 路径风格访问（MinIO 等 S3 兼容服务通常 true；布尔写法见文件头）
# STORAGE_S3_FORCE_PATH_STYLE=false
# 签名用的对外 endpoint（浏览器可达的公网域名；与 STORAGE_S3_ENDPOINT 内网地址不同时才填）
# STORAGE_S3_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ── 产物下载的 URI 拉取守卫（PR-04 SSRF）──
# 服务端允许 fetch 的 host：逗号分隔，支持 *.example.com 通配（不含裸域）；留空=只允许上面的存储自身 host
# CANVAS_DOWNLOAD_HOST_ALLOWLIST=*.cdn.example.com
# 单个远程产物大小上限（字节，默认 209715200=200MiB），超限立即中止
# CANVAS_DOWNLOAD_MAX_BYTES=209715200

# ── 能力开关与第三方集成（未配置即如实降级，不伪造成功）──
# 文本 LLM（大纲/角色/剧本/分镜）：mock 不访问供应商；real 需 DEEPSEEK_API_KEY
# LLM_MODE=mock
# DEEPSEEK_API_KEY= / DEEPSEEK_BASE_URL=https://api.deepseek.com / DEEPSEEK_MODEL=deepseek-chat
#
# 语音转写（Agent STT）：Key 只留服务端，下发给浏览器的是短期令牌；
# provider=browser 或缺 Key 时 /v1/agent/stt-token 返回 available=false，前端回落浏览器内置识别
# AGENT_STT_PROVIDER=browser
# AGENT_STT_API_KEY= / AGENT_STT_BASE_URL= / AGENT_STT_MODEL=
#
# 第三方登录（四个渠道全部可选；缺项即如实返回「未配置」，绝不伪造登录）
# OAUTH_WECHAT_APP_ID= / OAUTH_WECHAT_SECRET= / OAUTH_WECHAT_REDIRECT_URI=
# OAUTH_QQ_APP_ID= / OAUTH_QQ_APP_KEY= / OAUTH_QQ_REDIRECT_URI=
# OAUTH_APPLE_CLIENT_ID= / OAUTH_APPLE_TEAM_ID= / OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OAUTH_APPLE_REDIRECT_URI=
# OAUTH_DOUYIN_CLIENT_KEY= / OAUTH_DOUYIN_SECRET= / OAUTH_DOUYIN_REDIRECT_URI=
# 仅非生产生效：把 OAuth 回调短路成本地假用户（供 E2E 覆盖「登录成功」分支）；=1/true/yes/on 开启
# OAUTH_MOCK=0
#
# 行为验证码（登录/发码入口）：开启后强制校验，用本地算术题（无第三方依赖）；=1/true/yes/on 开启
# CAPTCHA_ENFORCE=0
# 第三方验证码供应商（留空 = 只用本地算术题）
# CAPTCHA_PROVIDER=
#
# 内容安全：内置词表随 MODERATION_ENABLED 生效（默认 true；=0/false/no/off 关闭）；自定义词以逗号分隔追加
# MODERATION_ENABLED=true
# MODERATION_WORDS=
#
# 影视版离线通知：留空则只走站内广播，不投递 webhook；
# 接收方用 FILM_NOTIFY_SECRET 校验 x-of-signature: sha256=<hex>（HMAC-SHA256）
# FILM_NOTIFY_WEBHOOK_URL= / FILM_NOTIFY_SECRET=
#
# 首页未读长轮询的单次挂起上限（毫秒，默认 25000；须低于反代 30s 读超时）
# HOME_UNREAD_TIMEOUT_MS=25000
#
# 切片发布转码：inline（默认，API 进程内跑 ffmpeg）/ worker（入队由 worker 消费，生产推荐）
# PUBLISH_TRANSCODE_MODE=inline
#
# 工具目录：true 才用代码定义覆盖库内模型/价目（默认 false，避免重启回滚运营改价）；=1/true/yes/on 开启
# CATALOG_SYNC_TOOLS=false
#
# 进程与可观测
# 停机宽限（毫秒，默认 25000）：超时强制退出，未完成请求由客户端重试
# SHUTDOWN_TIMEOUT_MS=25000
# /v1/health 上报的版本号（留空显示 dev）
# APP_VERSION=
# ffmpeg/ffprobe 可执行文件（默认取 PATH）
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# 短信/验证码/支付/供应商 Key 一律走服务器 env 或 CI Secrets，不写入本文件

# ── 支付渠道（api-spec §10）──
# PAYMENT_LIVE=false：仅 mock 渠道可用于联调；=true：只接受真实渠道下单/回调，mock 端点返回 403
# PAYMENT_LIVE=false
# ORDER_TTL_S=900
#
# 微信支付 APIv3（生产值全部由 Secrets 注入；以下仅为占位）
# WECHAT_MCH_ID=1900000000
# WECHAT_APP_ID=wx0000000000000000
# WECHAT_MCH_SERIAL_NO=0000000000000000000000000000000000000000
# 商户 API 私钥：内联 PEM（用 \n 换行）或挂载文件路径（二选一，推荐文件）
# WECHAT_MCH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# WECHAT_MCH_PRIVATE_KEY_PATH=/run/secrets/wechat_mch_private_key.pem
# APIv3 密钥（32 字符，回调解密）
# WECHAT_API_V3_KEY=change-me-32-chars
# 微信支付平台证书公钥（回调验签）：内联或文件路径
# WECHAT_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# WECHAT_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechat_platform_public_key.pem
# 平台证书轮换（推荐）：JSON {"<serial_no>":"<PEM>"}，可同时配置新旧证书；回调按 Wechatpay-Serial 选公钥
# WECHAT_PLATFORM_PUBLIC_KEYS={"5157F09EFDC096DE15EBE81A47057A7232FDB129":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
# WECHAT_PLATFORM_PUBLIC_KEYS_PATH=/run/secrets/wechat_platform_public_keys.json
# WECHAT_API_BASE=https://api.mch.weixin.qq.com
# WECHAT_NOTIFY_URL=https://api.example.com/v1/billing/notify/wechat
#
# 支付宝开放平台（RSA2）
# ALIPAY_APP_ID=2021000000000000
# ALIPAY_APP_PRIVATE_KEY_PATH=/run/secrets/alipay_app_private_key.pem
# ALIPAY_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ALIPAY_PUBLIC_KEY_PATH=/run/secrets/alipay_public_key.pem
# ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# 生产默认网关；沙箱请显式覆盖（沙箱网关不接受生产密钥）
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_NOTIFY_URL=https://api.example.com/v1/billing/notify/alipay
# ALIPAY_SIGN_TYPE=RSA2
#
# ── 生产启动守卫（NODE_ENV=production 时 fail fast；api-spec §10.6）──
# 必须显式提供且不能是仓库默认值：JWT_SECRET / PHONE_HMAC_PEPPER / PHONE_ENC_KEY
# 必须显式提供：ADMIN_USERNAME / ADMIN_PASSWORD；COOKIE_SECURE 必须显式设置（HTTPS 为 true）
# METRICS_TOKEN 必须显式设置：/v1/metrics 需 Bearer 令牌抓取（未配置时端点一律 401）
# PAYMENT_LIVE=true 时至少一个渠道凭据齐全；已配置但缺项的渠道会列出缺失变量并拒绝启动
