NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# 鉴权（ADR-006/007/008；生产必须通过服务器 env/CI Secrets 注入）
# JWT_SECRET=change-me-32bytes-min
# ACCESS_TTL_S=7200
# REFRESH_TTL_S=1209600
# PHONE_HMAC_PEPPER=change-me
# PHONE_ENC_KEY=change-me-32bytes
# 运营后台（生产必须显式设置；非生产缺省 admin/admin12345）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong
# ADMIN_JWT_TTL_S=7200

# Alpha 准入与新人礼包
# AUTH_REQUIRE_INVITE=false
# GIFT_CREDITS=80
# QUOTE_TTL_S=300

# 结果存储（本地驱动，生产替换 OSS/S3）
# STORAGE_DRIVER=local
# STORAGE_DIR=../../data/storage
# STORAGE_PUBLIC_BASE=http://127.0.0.1:3000/v1
# STORAGE_SIGN_SECRET=change-me
# S3/OSS（STORAGE_DRIVER=s3）
# STORAGE_S3_BUCKET=oneframe-results
# STORAGE_S3_REGION=cn-hangzhou
# STORAGE_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STORAGE_S3_ACCESS_KEY_ID= / STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=false

# 短信/验证码/支付/供应商 Key 一律走服务器 env 或 CI Secrets，不写入本文件
