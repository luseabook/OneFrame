# 生产环境变量（docker-compose.prod.yml 使用）
# 复制为 .env 后修改；不要提交真实密钥。

# 数据库 / Redis
POSTGRES_PASSWORD=change-me-strong
JWT_SECRET=change-me-at-least-32-bytes-random

# 运营后台（生产必须覆盖默认值）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong

# refresh_token Cookie 的 Secure 标记
# HTTPS 部署（生产）：true
# 纯 HTTP 部署（本地 compose / 内网）：false，否则浏览器不保存 Cookie → 刷新即掉登录
COOKIE_SECURE=true

# S3 / MinIO / OSS（S3 兼容）
S3_BUCKET=app-results
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 浏览器可访问的 S3 endpoint（生产为 https://files.example.com 或 OSS 公网域名）
S3_PUBLIC_ENDPOINT=http://localhost:9000

# AI 双标识（上线必须 true）
AI_LABEL_ENABLED=true
AI_LABEL_TEXT=AI生成

# 供应商：mock（演示）| real（HTTP 网关）
ADAPTER_MODE=mock
# HTTP_VIDEO_BASE_URL=https://vendor-gateway.example.com
# HTTP_VIDEO_API_KEY=

# 对外访问端口（nginx）
# docker compose 默认 8080
