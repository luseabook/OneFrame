# 生产环境变量（docker-compose.prod.yml 使用）
# 复制为 .env 后修改；不要提交真实密钥。
# 生产启动会做配置守卫：NODE_ENV=production 时弱默认密钥/缺失关键项会直接启动失败（见 apps/api/src/config/env.ts）。

# 数据库 / Redis
POSTGRES_PASSWORD=change-me-strong
JWT_SECRET=change-me-at-least-32-bytes-random
# PIPL 相关密钥（生产必须显式设置且不能使用仓库默认值）
PHONE_HMAC_PEPPER=change-me-strong-random
PHONE_ENC_KEY=change-me-32-bytes-random-key

# 运营后台（生产必须覆盖默认值）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong

# refresh_token Cookie 的 Secure 标记
# HTTPS 部署（生产）：true
# 纯 HTTP 部署（本地 compose / 内网）：false，否则浏览器不保存 Cookie → 刷新即掉登录
COOKIE_SECURE=true

# S3 / MinIO / OSS（S3 兼容）
S3_BUCKET=app-results
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 浏览器可访问的 S3 endpoint（生产为 https://files.example.com 或 OSS 公网域名）
S3_PUBLIC_ENDPOINT=http://localhost:9000

# AI 双标识（上线必须 true）
AI_LABEL_ENABLED=true
AI_LABEL_TEXT=AI生成

# ── 供应商适配层 ────────────────────────────────────────────────────────────
# mock（演示）| real（真实供应商）。生产必须 real（worker 启动守卫会拒绝 mock）
ADAPTER_MODE=real

# LLM 步骤（大纲/角色/剧本/分镜）：real 走 DeepSeek；mock 仅本地/CI
LLM_MODE=real
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 火山方舟（视频：内容生成异步任务；图像：Seedream 同步接口）——同一个 Key 服务两者
ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com
# 我方模型名 → Ark 模型/接入点 ID（JSON）
# ARK_MODEL_MAP={"seedance-2.5":"ep-xxxxxxxx"}
# ARK_IMAGE_MODEL_MAP={"tgi-2.5-flare":"doubao-seedream-4-0-250828"}
# 把仍标记为 tomoviee:image 的图像模型显式路由到 Ark 图像（逗号分隔；不配置则保持原报错，不静默 mock）
# ARK_IMAGE_REPLACE_CODES=tomoviee:image
# ARK_IMAGE_RESPONSE_FORMAT=url
# ARK_IMAGE_WATERMARK=true
# ARK_IMAGE_TIMEOUT_MS=120000

# 通用 HTTP 视频/图像供应商网关（可选；配置后未识别的 vendor code 会走它）
# HTTP_VIDEO_BASE_URL=
# HTTP_VIDEO_API_KEY=

# ── 支付渠道（PAYMENT_LIVE=true 时真实收款；凭据缺失时 /v1/billing/channels 标记 missing）──
# 生产设为 true；false 时只允许 mock 联调渠道，非 mock 下单直接拒绝
PAYMENT_LIVE=false
# ORDER_TTL_S=900

# 微信支付 APIv3（Native/H5/JSAPI 按需签约；回调必须公网 HTTPS 且与 WECHAT_NOTIFY_URL 一致）
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_MCH_SERIAL_NO=
# 商户 API 私钥：生产推荐挂载文件（/run/secrets/...），或内联 PEM（\n 转义）
# WECHAT_MCH_PRIVATE_KEY_PATH=/run/secrets/wechat_mch_private_key.pem
# WECHAT_API_V3_KEY=            # 32 字符
# 回调验签平台公钥：单证书用 WECHAT_PLATFORM_PUBLIC_KEY(_PATH)；
# 需要证书轮换时用 JSON（serial → PEM），按回调头 Wechatpay-Serial 选择
# WECHAT_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechat_platform_public_key.pem
# WECHAT_PLATFORM_PUBLIC_KEYS_PATH=/run/secrets/wechat_platform_public_keys.json
# WECHAT_NOTIFY_URL=https://app.example.com/v1/billing/notify/wechat

# 支付宝（RSA2；生产网关默认 https://openapi.alipay.com/gateway.do，沙箱需显式覆盖）
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY_PATH=/run/secrets/alipay_app_private_key.pem
# ALIPAY_PUBLIC_KEY_PATH=/run/secrets/alipay_public_key.pem
# ALIPAY_NOTIFY_URL=https://app.example.com/v1/billing/notify/alipay
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_SIGN_TYPE=RSA2

# 对外访问端口（nginx）
# docker compose 默认 8080
