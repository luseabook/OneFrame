# 生产环境变量（docker-compose.prod.yml 使用）
# 用法：cp .env.production.example .env 后**逐项替换** CHANGE_ME 值；不要提交真实密钥。
#
# 两条硬约束（PR-01/PR-05）：
# 1) compose 对下面的密钥类变量全部使用 `${VAR:?}` 语法：**缺一项 `docker compose up` 直接报错**，
#    不存在"用默认值先跑起来"这条路。
# 2) `apps/api/src/config/env.ts` 的生产守卫还会拒绝：仓库默认值（dev-only-*）、
#    占位符（change-me / example / placeholder / your- / <...>）、以及字符类别 <3 类的弱值。
#    也就是说：**照抄本文件里的 CHANGE_ME 值上线，会在启动时被拒绝**（这是有意的）。
#
# 生成密钥：openssl rand -base64 32

# 数据库 / Redis
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
# 管理端 token 专用密钥（PR-05：与用户域必须不同！用户 token 密钥泄露不得导致 admin 可伪造）
# 换一把新的、不要复用 JWT_SECRET：openssl rand -base64 32
ADMIN_JWT_SECRET=CHANGE_ME_openssl_rand_base64_32_admin
# PIPL 相关密钥（生产必须显式设置且不能使用仓库默认值）：openssl rand -base64 32
PHONE_HMAC_PEPPER=CHANGE_ME_openssl_rand_base64_32
# PHONE_ENC_KEY 用于手机号加密：openssl rand -base64 32
PHONE_ENC_KEY=CHANGE_ME_openssl_rand_base64_32
# 存储直链签名密钥（仓库默认 dev-only-storage-sign-secret 会被守卫拒绝）：openssl rand -base64 32
STORAGE_SIGN_SECRET=CHANGE_ME_openssl_rand_base64_32

# 运营后台（生产必须覆盖默认值；口令至少 3 类字符）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password_openssl_rand_base64_32

# refresh_token Cookie 的 Secure 标记
# 本 compose 的 nginx **已经在 443 上终止 TLS**（第 107 批）→ 生产写 true
# 若改造成"外层 LB 终止、容器只开 HTTP"的部署：写 false，否则浏览器不保存 Cookie → 刷新即掉登录
# compose 已改为 `${COOKIE_SECURE:?}`：**必须显式写 true 或 false**，不再默认 false。
COOKIE_SECURE=true

# `/v1/metrics` 的 Prometheus 抓取令牌（Authorization: Bearer <METRICS_TOKEN>）
# 指标含任务积压、失败率与「已支付未入账」等资金异常，不能匿名可读；未设置则端点一律 401，
# 生产启动守卫也会拒绝启动。生成：openssl rand -base64 32
METRICS_TOKEN=CHANGE_ME_metrics_bearer_token_openssl_rand_base64_32

# S3 / MinIO / OSS（S3 兼容）
S3_BUCKET=app-results
S3_REGION=us-east-1
# ⚠️ 不再是 minioadmin：那是公开已知口令，守卫会拒绝，compose 也不再给默认值。
# 自建 MinIO 用：openssl rand -base64 24
S3_ACCESS_KEY=CHANGE_ME_minio_root_user
S3_SECRET_KEY=CHANGE_ME_minio_root_password_openssl_rand_base64_24
# 浏览器可访问的 S3 endpoint（生产为 https://files.your-domain.tld 或 OSS 公网域名）
S3_PUBLIC_ENDPOINT=http://localhost:9000

# AI 双标识（上线必须 true）
AI_LABEL_ENABLED=true
AI_LABEL_TEXT=AI生成

# ── 供应商适配层 ────────────────────────────────────────────────────────────
# mock（演示）| real（真实供应商）。生产必须显式 real（worker 启动守卫会拒绝 mock/空值）
# ⚠️ 必须显式设置：compose 不再提供 mock 默认值，留空会导致 worker 启动即失败。
ADAPTER_MODE=real

# LLM 步骤（大纲/角色/剧本/分镜）：real 走 DeepSeek；mock 仅本地/CI
# ⚠️ real 必须同时配置 DEEPSEEK_API_KEY：否则生产启动会 fail fast（2026-10-26 起，
#    不允许再静默回落到 mock 文案——那会让"看起来在跑"实际输出假内容）
LLM_MODE=real
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 火山方舟（视频：内容生成异步任务；图像：Seedream 同步接口）——同一个 Key 服务两者
ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com
# 我方模型名 → Ark 模型/接入点 ID（JSON）
# ARK_MODEL_MAP={"seedance-2.5":"ep-xxxxxxxx"}
# ARK_IMAGE_MODEL_MAP={"tgi-2.5-flare":"doubao-seedream-4-0-250828"}
# 把仍标记为 tomoviee:image 的图像模型显式路由到 Ark 图像（逗号分隔；不配置则保持原报错，不静默 mock）
# ARK_IMAGE_REPLACE_CODES=tomoviee:image
# ARK_IMAGE_RESPONSE_FORMAT=url
# ARK_IMAGE_WATERMARK=true
# ARK_IMAGE_TIMEOUT_MS=120000

# 通用 HTTP 视频/图像供应商网关（可选；配置后未识别的 vendor code 会走它）
# HTTP_VIDEO_BASE_URL=
# HTTP_VIDEO_API_KEY=

# ── 支付渠道（PAYMENT_LIVE=true 时真实收款；凭据缺失时 /v1/billing/channels 标记 missing）──
# ⚠️ 必填且必须显式写 true 或 false（PR-02：生产不允许靠 false 默认值决定"要不要真收款"）。
# 注意安全口径：mock 支付端点在 NODE_ENV=production 下**一律 403**，
# 无论本项取值如何 —— PAYMENT_LIVE 只是业务开关，不是安全开关。
PAYMENT_LIVE=CHANGE_ME_true_or_false
# ORDER_TTL_S=900

# 微信支付 APIv3（Native/H5/JSAPI 按需签约；回调必须公网 HTTPS 且与 WECHAT_NOTIFY_URL 一致）
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_MCH_SERIAL_NO=
# 商户 API 私钥：生产推荐挂载文件（/run/secrets/...），或内联 PEM（\n 转义）
# WECHAT_MCH_PRIVATE_KEY_PATH=/run/secrets/wechat_mch_private_key.pem
# WECHAT_API_V3_KEY=            # 32 字符
# 回调验签平台公钥：单证书用 WECHAT_PLATFORM_PUBLIC_KEY(_PATH)；
# 需要证书轮换时用 JSON（serial → PEM），按回调头 Wechatpay-Serial 选择
# WECHAT_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechat_platform_public_key.pem
# WECHAT_PLATFORM_PUBLIC_KEYS_PATH=/run/secrets/wechat_platform_public_keys.json
# WECHAT_NOTIFY_URL=https://app.example.com/v1/billing/notify/wechat

# 支付宝（RSA2；生产网关默认 https://openapi.alipay.com/gateway.do，沙箱需显式覆盖）
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY_PATH=/run/secrets/alipay_app_private_key.pem
# ALIPAY_PUBLIC_KEY_PATH=/run/secrets/alipay_public_key.pem
# ALIPAY_NOTIFY_URL=https://app.example.com/v1/billing/notify/alipay
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_SIGN_TYPE=RSA2

# ── 对外入口（nginx：TLS 终止在 compose 内，第 107 批）──────────────────────
# 入口域名：80 会 308 跳转到 https://<TLS_SERVER_NAME>；证书 CN/SAN 必须匹配这个值。
# 缺失时 `docker compose up` 在解析阶段就报错（nginx 服务用 `${TLS_SERVER_NAME:?}`）。
TLS_SERVER_NAME=CHANGE_ME_app_example_com
# 证书目录 / ACME 校验目录（可选，compose 变量，默认 ./deploy/certs、./deploy/acme-webroot）
# TLS_CERT_DIR=./deploy/certs
# TLS_ACME_WEBROOT=./deploy/acme-webroot
# 首次冒烟：./deploy/gen-selfsigned-cert.sh "$TLS_SERVER_NAME"（自签，浏览器会警告，仅用于验证握手）
# 生产证书：deploy/certs/fullchain.pem + deploy/certs/privkey.pem —— 私钥不进仓库（.gitignore 已忽略）
