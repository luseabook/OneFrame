# ⚠️ 本文件由 OneFrame 维护，与上游 `env.example.upstream` 的**每一处差异都在注释里写明理由**。
# 部署：cp .env.example .env && 填 API_KEYS
#
# 本网关只做一件事：把剪影 App 的 AI 生图协议包成 OpenAI Images API。
# 我方（OneFrame）的接入方式见 docs/02-architecture/jianying-gateway-integration.md

# ============================ server ============================
# 容器形态由 docker-compose.prod.yml 显式覆盖成 0.0.0.0（容器间反代依赖）；
# 本机开发保持 loopback，别把网关裸露到局域网。
HOST=127.0.0.1
PORT=8788
LOG_LEVEL=info

# 【必填】网关自身的访问控制。留空时网关**拒绝启动**（fail-closed），
# 任何能访问 8788 的进程都能消耗上游额度 —— 不要靠"没人知道端口"来防。
# 生成：openssl rand -hex 24
# 我方 worker 通过 model_providers 的 Key（密文）发 Bearer，不走环境变量明文。
API_KEYS=
# 仅限隔离的本机开发：显式豁免"必须有 API_KEYS"的启动检查。生产永远不要开。
ALLOW_OPEN_GATEWAY=0
# 浏览器跨域白名单（逗号分隔，如 https://app.example.com）。默认空 = 不发 CORS 头，
# 服务间调用（worker→网关）不需要。绝不要写 *。
CORS_ORIGINS=

# ========================== upstream ============================
# 剪影开放接口（逆向自 com.mediaeditor.video 5.2.2）
UPSTREAM_BASE=http://newapi.jianyingeditor.cn
# 上游协议常量（逆向自 APK，非部署密钥）。默认值内置于 app/jianying.py；
# 上游换版时可在此覆盖，无需改代码。
# JY_RSA_PUB_B64=
# JY_AES_KEY=
CONNECT_TIMEOUT=10
READ_TIMEOUT=180
# 上游并行生成上限。上游单张 10–25s，8 路只是"能跑"；
# 我方 worker 侧对 jianying:image 另有并发闸，这里取 4 留一半余量给人工排查。
MAX_CONCURRENCY=4
# 每个 API key 每分钟请求上限（0 = 不限）。防单 key 占满并发槽饿死其他调用方。
MAX_REQUESTS_PER_MINUTE=60
UPSTREAM_RETRIES=3
RETRY_BACKOFF=1.2
TRUST_ENV=true

# ---------------------- circuit breaker -------------------------
CB_FAIL_THRESHOLD=8
CB_OPEN_SECONDS=30

# =========================== images =============================
DATA_DIR=./data
# 24h：我方 worker 生成后立即转存到自有 OSS，TTL 只需要覆盖"转存失败的人工补转窗口"
# （上游默认 72h 是给「直接用网关 URL」的场景，我们不那么用）
FILE_TTL_HOURS=24
MAX_OUTPUT_SIDE=2048
# 上游下载（生成图/参考图）单文件上限，防被篡改的 URL 返回超大响应
MAX_DOWNLOAD_MB=24
DEFAULT_MODEL=jianying-draw
DEFAULT_STYLE=

# 🔴 强制 false —— 不要改。
# 上游文生图会烧录右下角「AI生成」角标。擦除它 = 破坏可追溯标识，且实现方式是
# 再调一次上游蒙版修复（每张 +4–8s、额外计费一次上游额度）。本项目的 AI 标识是
# worker 在结算前的硬门（apps/worker/src/label.ts），标识统一由我方产出，
# 网关侧必须原样保留上游标识。
REMOVE_WATERMARK=false

# 风格迁移默认效果（我方前端强制用户显式选择，这里只是兜底）
DEFAULT_EFFECT=aliyun_tongyi_1

# 网关自己的公网地址。**只有**在「用文件上传做编辑」时才需要：
# 上游是按 URL 拉图的。我方图生图传的是预签名 URL（字符串），所以通常留空。
PUBLIC_BASE_URL=
UPLOAD_FALLBACK=none
UPLOAD_FALLBACK_TTL=1h
MAX_UPLOAD_MB=20