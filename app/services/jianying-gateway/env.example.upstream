# ============================ server ============================
HOST=0.0.0.0
PORT=8788
LOG_LEVEL=info

# comma separated bearer keys; leave empty for an open gateway
API_KEYS=
# API_KEYS=sk-local-123456

# ========================== upstream ============================
# JianYing open API host (reverse engineered from com.mediaeditor.video 5.2.2)
UPSTREAM_BASE=http://newapi.jianyingeditor.cn
CONNECT_TIMEOUT=10
READ_TIMEOUT=180
# max parallel upstream generations; generation takes ~10-20s each
MAX_CONCURRENCY=8
UPSTREAM_RETRIES=3
RETRY_BACKOFF=1.2
# set to false to bypass system HTTP(S)_PROXY variables
TRUST_ENV=true

# ---------------------- circuit breaker -------------------------
CB_FAIL_THRESHOLD=8
CB_OPEN_SECONDS=30

# =========================== images =============================
# local cache directory (generated + uploaded images)
DATA_DIR=./data
FILE_TTL_HOURS=72
MAX_OUTPUT_SIDE=2048
DEFAULT_MODEL=jianying-draw
DEFAULT_STYLE=
# erase the baked-in "AI生成" watermark via the app's own inpaint endpoint
# (adds ~4-8s per image; per-request override: "watermark":"keep")
REMOVE_WATERMARK=true
# style transfer effect used by /v1/images/edits without a mask
DEFAULT_EFFECT=aliyun_tongyi_1

# Public base URL of THIS gateway, e.g. https://img.example.com
# Required only for /v1/images/edits with a local file upload: the upstream
# service must be able to fetch the image over the internet.
PUBLIC_BASE_URL=

# optional anonymous temporary host for uploads when PUBLIC_BASE_URL is empty
# none | catbox
UPLOAD_FALLBACK=none
UPLOAD_FALLBACK_TTL=1h
MAX_UPLOAD_MB=20
