# 生产入口（第 107 批）：**TLS 终止在 nginx 这一层**，80 只做 ACME 校验与跳转。
#
# 这是一个 **模板**：nginx 官方镜像的 entrypoint 会把 /etc/nginx/templates/*.template
# 用 envsubst 渲染到 /etc/nginx/conf.d/default.conf。容器里只定义 `${TLS_SERVER_NAME}`
# 这一个变量，所以 `$host` / `$request_uri` / `$scheme` 等 nginx 变量原样保留。
#
# 证书从宿主机只读挂载到 /etc/nginx/certs（fullchain.pem + privkey.pem）。
# 私钥**不进仓库、不进镜像**：见 .gitignore 里的 app/deploy/certs/*。

# Docker 内置 DNS（127.0.0.11）：容器重建后 IP 会变，
# 静态 upstream 解析会缓存旧 IP → 502。此处用 resolver + 变量实现运行时重解析。
resolver 127.0.0.11 valid=10s ipv6=off;

# ── 访问日志：**不落查询串**（P1-9）────────────────────────
# SSE 端点（/v1/agent/task/stream、/v1/.../stream）只能把凭据放在 `?stream_token=`，
# 而 nginx 默认 combined 格式的 `$request` 会原样带上查询串 → 短时效令牌落盘/进日志采集。
# 这里只用 `$request_method $uri $server_protocol`（`$uri` 不含 `?query`），
# 并且不记录 Referer（外部页面可把令牌拼进 Referer）。
# 残留风险：上游 5xx/timeout 时 error_log 可能回显完整请求行（含查询串）；
# stream_token 的 TTL 只有 120s（common/stream-token.ts），且不能当普通 Bearer 用（AuthGuard 已收紧）。
log_format oneframe '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'rt=$request_time urt=$upstream_response_time';
access_log /var/log/nginx/access.log oneframe;

# ── 真实客户端 IP ───────────────────────────────────
# 部署在 CDN/LB 之后时，只有可信代理发来的 X-Forwarded-For 才会被采纳，
# 避免用户伪造 XFF 绕过发码/举报频控。
# 可信代理网段按实际环境调整（生产填 CDN/LB 的出口网段）。
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# ── 80：只保留 ACME HTTP-01 校验 + 永久跳转，不再承载业务 ─────────
server {
  listen 80;
  server_name ${TLS_SERVER_NAME};

  # certbot --webroot -w <宿主机目录> 续期时把 token 写进这个目录；
  # 容器只读挂载 /var/www/certbot（见 docker-compose.prod.yml）。
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    access_log off;
  }

  # 308（永久，且保留方法与请求体语义）。
  # 跳转目标写死为配置里的域名，**不用 $host** —— 拿 Host 头拼跳转目标等于开放重定向。
  location / {
    return 308 https://${TLS_SERVER_NAME}$request_uri;
  }
}

# ── 443：真正的业务入口 ────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name ${TLS_SERVER_NAME};
  # P1-10：必须与 API 的 bodyLimit（48MB）对齐。原来是 12m —— 图片/音频以 base64 单请求上传时
  # 会被网关先 413 掉，而应用侧日志里什么都看不到（请求没到 api），排查成本极高。
  client_max_body_size 48m;

  # ── 证书 ──────────────────────────────────────────
  # fullchain.pem = 站点证书 + 中间证书；漏了中间证书会让部分安卓/旧客户端握手失败。
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  # Mozilla intermediate 配置（TLS 1.2 只留 ECDHE + AEAD；TLS 1.3 由协议决定套件）
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305";
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  # ── 安全响应头（P1-10）────────────────────────────────
  # 这些是"零成本、不改变业务行为"的一组；CSP 需要先做 nonce 集成，见文件末尾的模板。
  add_header X-Content-Type-Options "nosniff" always;
  # 同源嵌入（画面预览/分享页 iframe）要保留，因此不能用 DENY
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # 本站不需要摄像头/麦克风/定位（生成走服务端；语音输入是浏览器侧 MediaRecorder，属 microphone）
  # ⚠️ 若要放开语音输入，把 microphone 从 () 改成 (self)
  add_header Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()" always;
  # OAuth（微信/Apple）走弹窗回跳，必须是 allow-popups，否则登录回调被切断
  add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
  add_header Cross-Origin-Resource-Policy "same-site" always;
  # HSTS：现在确实跑在 HTTPS 上了（第 107 批），所以启用。
  # `includeSubDomains` 的前提是**所有子域都走 HTTPS**（部署文档里的 www/app/api/static 都配了通配符证书）；
  # 若只想覆盖本站，删掉 `; includeSubDomains`。
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  #
  # ⚠️ CSP：Nuxt 的 hydration 需要内联脚本，未接 nonce/`__NUXT__` 摘取前启用会白屏。
  # 接好 nonce（nuxt-security 或自建 plugin 注入 `script-src 'nonce-...'`）后启用下面这行：
  # add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; script-src 'self' 'nonce-<INJECT>'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; frame-ancestors 'self'" always;

  # 容器健康检查：不走 /v1（不必依赖 api 活着），也不写访问日志。
  location = /nginx-health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # API 与 Web 同源：/v1 反代到 NestJS，其余到 Nuxt
  location /v1/ {
    set $api_upstream "api:3000";
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # $remote_addr 已被 real_ip 模块改写为真实客户端 IP
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  location / {
    set $web_upstream "web:3001";
    proxy_pass http://$web_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}