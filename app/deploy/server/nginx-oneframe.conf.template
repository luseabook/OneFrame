# OneFrame 万星 —— 独立 server 块
#
# 共享机铁律（改之前先读）：
#   1) 绝不改 nginx.conf 全局；只往 /etc/nginx/sites-available/ 加本文件并软链到 sites-enabled。
#   2) 别人的站是 80/443 的 default_server（server_name 含 `_` 与本机 IP）。
#      因此本块 **只能精确匹配自己的域名**：绝不写 `_`、绝不写裸 IP，
#      否则会跟 default_server 抢 Host，把别人的站顶掉。
#   3) 未备案域名的访问会在云厂商边缘被拦（403 + 非法阻断页），到不了这里；
#      这与本配置无关，属 EXT-03 备案阻塞。
#   4) /v1/ 必须直连 api，不经 Nuxt 代理：产物里的 baked proxy 会把来源 IP
#      覆盖成字面量 `{clientIp}`，导致全站共用一个频控桶、审计日志记假 IP。
#
# 模板变量：{{DOMAIN}} {{API_UPSTREAM}} {{WEB_UPSTREAM}} {{LOG_DIR}} {{CLIENT_MAX_BODY}}
#           {{PROXY_READ_TIMEOUT}}   （由 04-install-vhost.sh 用 envsubst 渲染）

upstream oneframe_api { server {{API_UPSTREAM}}; keepalive 16; }
upstream oneframe_web { server {{WEB_UPSTREAM}}; keepalive 16; }

server {
    listen 80;
    listen [::]:80;
    # 备选：给一个独立端口做 IP 直连验收（需安全组放行；默认注释）
    # listen 8080;
    # listen [::]:8080;

    server_name {{DOMAIN}};      # 只写精确域名，见铁律 2

    client_max_body_size {{CLIENT_MAX_BODY}};
    client_body_timeout 60s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    gzip_min_length 1024;

    access_log {{LOG_DIR}}/nginx-oneframe.access.log oneframe;
    error_log  {{LOG_DIR}}/nginx-oneframe.error.log warn;

    # ── A 方案：/v1/ 直连 api ──
    # api 侧 clientIp() 先看 X-Real-IP、再退 XFF 最左（apps/api/src/common/client-ip.ts:11-22）。
    # 两行都必须写，且 X-Real-IP 必须覆盖客户端自带值，否则伪造头可绕过发码频控。
    location /v1/ {
        proxy_pass http://oneframe_api;          # 不带尾斜杠：api 自己带 /v1 前缀
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout {{PROXY_READ_TIMEOUT}};
        proxy_send_timeout {{PROXY_READ_TIMEOUT}};
        proxy_buffering off;                     # 导出/流式下载不落盘
    }

    # ── 其余交给 Nuxt node server ──
    location / {
        proxy_pass http://oneframe_web;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout {{PROXY_READ_TIMEOUT}};
    }
}
