[Unit]
Description=OneFrame Web (Nuxt node server)
After=network-online.target oneframe-api.service
Wants=network-online.target

[Service]
Type=simple
User=oneframe
Group=oneframe
WorkingDirectory={{BASE}}/app/apps/web
EnvironmentFile={{ENVD}}/web.env
Environment=NODE_OPTIONS=--max-old-space-size=320
ExecStart=/usr/bin/node {{BASE}}/app/apps/web/.output/server/index.mjs
Restart=on-failure
RestartSec=5
StandardOutput=append:{{BASE}}/logs/web/web.log
StandardError=append:{{BASE}}/logs/web/web.err.log

MemoryMax=380M
TasksMax=128
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{BASE}}/logs/web

[Install]
WantedBy=multi-user.target
