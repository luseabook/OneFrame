# Dependencies / build outputs
node_modules/
dist/
.output/
.nuxt/
.turbo/
coverage/
*-out.txt

# Env / secrets (examples only)
.env
.env.*
!.env.example
!**/.env.example

# Local tool state (agent hooks / memory) / local object storage
.mimosa/
.workbuddy/
data/

# Reverse-engineering raw captures are intentionally NOT versioned (large / privacy).
# Only curated evidence is tracked: report, model catalog, routes, CLI skill/contracts, screenshots.
rea-reelmate/*
!rea-reelmate/REELMATE-逆向分析报告.md
!rea-reelmate/model-catalog-summary.json
!rea-reelmate/routes.txt
!rea-reelmate/modules.txt
!rea-reelmate/tabids.txt
!rea-reelmate/api-log-decoded.txt
!rea-reelmate/cli-skill/
!rea-reelmate/cli-out/
!rea-reelmate/*.png

# 验收临时脚本与依赖（不入库）
# 验收脚本默认不入库（含临时调试脚本）；仅保留可复跑门禁脚本
_acceptance/*
!_acceptance/compliance-check.cjs
!_acceptance/b-type-acceptance.ps1
!_acceptance/ledger-repair.cjs
!_acceptance/e2e-new-pages.cjs
!_acceptance/e2e-new-pages/
# 本轮（第 1 轮六批次）起：一键门禁与分批交付报告入库。
# 前者是 docs/07-plan/implement-progress-vs-reelmate.md §8.2 的复跑入口，
# 后者是各批次"竞品证据行号"与"已知偏离/未完成"清单的落点（不进 docs 是因为
# 它们随批次产生、且含逐条实现细节，硬塞进 api-spec 会淹没契约本身）。
!_acceptance/verify-round.ps1
!_acceptance/_team/

# 全站复刻的差距底账与证据（2026-10-26 起入库，可复核）
# _gap/：三条基线与门禁/代码/合规实测；ref2/：参照站公开页采集证据
# ref-authed/：登录态 22 页采集（已脱敏：手机号/uid/token/OSS 签名全部替换；重复截图已去重）
!_acceptance/_gap/
!_acceptance/ref2/
!_acceptance/ref-authed/
!_acceptance/capture-public.cjs
!_acceptance/capture-authed.cjs
!_acceptance/scrub-pii.cjs
!_acceptance/probe-auth.cjs
# 域级 HTTP 冒烟（可复跑，作为端到端回归文档）
!_acceptance/smoke-team-http.cjs
!_acceptance/smoke-team-topup.cjs
!_acceptance/mcp-check.cjs
# 本地依赖启动（PG 55432 / Redis 6380；宿主重启后靠它恢复，
# 避免"依赖没起"被误判成代码坏——本轮实际踩过）
!_acceptance/start-local-stack.ps1
# 本项目专属开发栈（api 3002 / web 3003）。**必须入库**：
# 3000/3001 被同机另一个项目（E:\ecpm）常驻占用，且本项目 api 只读 process.env
# 不加载 .env —— 没有这个脚本，换机器/重启后无法复现环境，
# 会再次把"别人的 3000"误当成自家 API（本轮实际踩过，详见
# _acceptance/_gap/canvas-frontend-baseline.md §1）。
!_acceptance/start-wanxing-stack.ps1
!_acceptance/restart-api.ps1
# 画布域验收：画布是状态最多的界面（视口/选择/锁/版本/快照），
# 纯 typecheck 无法证明拖拽-连线-保存-冲突真的能工作，必须有行为断言。
!_acceptance/canvas-acceptance.ps1
!_acceptance/e2e-canvas-editor.cjs
!_acceptance/canvas-probe.cjs
# 导演台多用户协同验收：单浏览器 + 造心跳证明不了「两个真账号在同一场景里协同」，
# 这条链路上压着成员加入、活动空间切换（X-Space-Id）、双向心跳、乐观锁冲突与覆盖，
# 只能在两个隔离浏览器上下文里跑。脚本入库，结果写进 _acceptance/_team/report-director.md。
!_acceptance/e2e-director-collab.cjs
# 运营后台 10 个面板的浏览器冒烟：面板是"整体能 build、单页却白屏"的高发区
# （v-if 漏挂 / endpoint 写错 / composable 未导入都过得了 typecheck）。
# 脚本入库；结果与未覆盖范围写进 _acceptance/_team/report-admin-panels.md。
!_acceptance/e2e-admin-panels.cjs
# 邀请码并发/陈旧快照验收：单进程单浏览器证明不了「两个管理员同时点同一条码」，
# 也证明不了「核销后后台快照仍旧、点删除被正确拒绝」。脚本入库，结果写进批次报告。
!_acceptance/e2e-invite-race.cjs

# 本地依赖运行时数据（PG/Redis 数据目录，66MB+，绝不入库）
.localstack/

# TLS 私钥绝不入库：app/deploy/gen-selfsigned-cert.sh 生成的自签证书只用于冒烟，
# 生产证书由部署机放置/续期（deploy/certs 只读挂进 nginx）。
app/deploy/certs/*
!app/deploy/certs/.gitkeep
# ACME HTTP-01 校验目录（certbot 写入的一次性 token）
app/deploy/acme-webroot/*
!app/deploy/acme-webroot/.gitkeep

# 本地运维工具（含批量注册/代理/指纹类脚本）只在本地使用，不进公开仓库；
# 文档编辑产生的 .bak 备份同理。
tools/
*.bak*

